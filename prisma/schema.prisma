// Prisma Schema - PLATAFORMA SAAS PROSPERE COMPLETA
// Portal Premium de Experiências, Benefícios e Acúmulo Patrimonial

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTENTICAÇÃO
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  role          String    @default("CLIENTE") // CLIENTE, VENDEDOR, PARCEIRO, LIDER, ADMIN, FINANCEIRO
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth
  accounts Account[]
  sessions Session[]

  // Relacionamentos
  clientProfile ClientProfile?
  sellerProfile SellerProfile?
  teamLeader    Team[]            @relation("TeamLeader")
  sellerLeaders SellerProfile[]   @relation("SellerLeader")
  clientSales   Sale[]            @relation("ClientSales")
  sellerSales   Sale[]            @relation("SellerSales")
  partnerSales  Sale[]            @relation("PartnerSales")
  commissions   CommissionEntry[]
  payouts       Payout[]          @relation("UserPayouts")
  clubLevels    UserClubLevel[]
  reservations  Reservation[]
  badges        UserBadge[]
  quotas            Quota[]
  simulations       Simulation[]
  importBatches     ImportBatch[]
  importBatchesFor  ImportBatch[]   @relation("ImportedForUser")
  auditLogs         AuditLog[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// PERFIS
// ============================================

model ClientProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  cpf               String?   @unique
  phone             String?
  birthDate         DateTime?
  address           String?
  patrimonyEstimate Float     @default(0)
  currentLevelId    String?
  importedById      String?
  achievedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubLevel ClubLevel? @relation(fields: [currentLevelId], references: [id])
  quotas    Quota[]

  @@index([currentLevelId])
  @@index([cpf])
  @@map("client_profiles")
}

model SellerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  cpf            String?
  phone          String?
  leaderId       String?
  teamId         String?
  commissionRate Float    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  leader User?  @relation("SellerLeader", fields: [leaderId], references: [id])
  team   Team?  @relation(fields: [teamId], references: [id])
  sales  Sale[]

  @@index([leaderId])
  @@index([teamId])
  @@map("seller_profiles")
}

model Team {
  id          String   @id @default(cuid())
  name        String
  leaderId    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leader  User            @relation("TeamLeader", fields: [leaderId], references: [id])
  sellers SellerProfile[]

  @@index([leaderId])
  @@map("teams")
}

// ============================================
// CLUBE DE BENEFÍCIOS
// ============================================

model ClubLevel {
  id           String   @id @default(cuid())
  name         String   @unique
  displayName  String
  minCreditBRL Float    @default(0)
  maxCreditBRL Float?
  color        String
  icon         String?
  description  String?
  benefits     String
  rules        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clients      ClientProfile[]
  members      UserClubLevel[]
  experiences  Experience[]
  reservations Reservation[]

  @@index([minCreditBRL])
  @@map("club_levels")
}

model UserClubLevel {
  id          String    @id @default(cuid())
  userId      String
  clubLevelId String
  creditBRL   Float     @default(0)
  achievedAt  DateTime  @default(now())
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubLevel ClubLevel @relation(fields: [clubLevelId], references: [id])

  @@unique([userId, clubLevelId, achievedAt])
  @@index([userId])
  @@index([clubLevelId])
  @@map("user_club_levels")
}

// ============================================
// EXPERIÊNCIAS / EVENTOS
// ============================================

model Experience {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  description      String?
  longDescription  String?
  imageUrl         String?
  gallery          String?
  videoUrl         String?
  location         String?
  address          String?
  category         String?
  tags             String?
  status           String   @default("active")
  eligibilityRules String?
  benefits         String?
  metadata         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  clubLevelId  String?
  clubLevel    ClubLevel?       @relation(fields: [clubLevelId], references: [id])
  dates        ExperienceDate[]
  reservations Reservation[]
  badges       Badge[]

  @@index([slug])
  @@index([status])
  @@index([category])
  @@map("experiences")
}

model ExperienceDate {
  id              String   @id @default(cuid())
  experienceId    String
  date            DateTime
  time            String?
  maxCapacity     Int
  capacityByLevel String?
  availableSlots  Int
  price           Float    @default(0)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  experience   Experience    @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([experienceId])
  @@index([date])
  @@map("experience_dates")
}

model Reservation {
  id               String    @id @default(cuid())
  userId           String
  experienceId     String
  experienceDateId String
  clubLevelId      String
  status           String    @default("pending")
  guestCount       Int       @default(1)
  maxGuests        Int       @default(1)
  qrCode           String?   @unique
  qrCodeImage      String?
  reservationDate  DateTime?
  checkInAt        DateTime?
  checkOutAt       DateTime?
  notes            String?
  metadata         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience Experience     @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  date       ExperienceDate @relation(fields: [experienceDateId], references: [id], onDelete: Cascade)
  clubLevel  ClubLevel      @relation(fields: [clubLevelId], references: [id])
  guests     Guest[]
  badges     UserBadge[]

  @@index([userId])
  @@index([experienceId])
  @@index([experienceDateId])
  @@index([status])
  @@index([qrCode])
  @@map("reservations")
}

model Guest {
  id            String    @id @default(cuid())
  reservationId String
  name          String
  email         String?
  phone         String?
  cpf           String?
  birthDate     DateTime?
  isLead        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("guests")
}

// ============================================
// GAMIFICAÇÃO
// ============================================

model Badge {
  id           String   @id @default(cuid())
  name         String   @unique
  displayName  String
  description  String?
  icon         String?
  category     String?
  criteria     String
  experienceId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  experience Experience? @relation(fields: [experienceId], references: [id])
  users      UserBadge[]

  @@index([category])
  @@map("badges")
}

model UserBadge {
  id            String   @id @default(cuid())
  userId        String
  badgeId       String
  reservationId String?
  achievedAt    DateTime @default(now())
  metadata      String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge       Badge        @relation(fields: [badgeId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@map("user_badges")
}

// ============================================
// COTAS E PATRIMÔNIO (DADOS REAIS - OPERAÇÃO)
// ============================================
// ⚠️ REGRA CRÍTICA: NUNCA FK para Simulation, SimulationRun, etc.
// ⚠️ Este módulo é 100% isolado das simulações

model Quota {
  id                String   @id @default(cuid())
  userId            String
  clientProfileId   String?
  importBatchId     String?
  administradora    String?
  empresa           String?
  grupo             String
  cota              String
  versao            String
  dataVenda         String?
  situacaoCobranca  String
  contemplacao      String
  percentPago       Float    @default(0)
  percentAtraso     Float    @default(0)
  percentFundoComum Float    @default(0)
  pclsPagar         Int      @default(0)
  pclsPagas         Int      @default(0)
  pclsPagasEmDia    Int      @default(0)
  pclsPagasAtraso   Int      @default(0)
  pclsEmAtraso      Int      @default(0)
  vlBem             Float    @default(0)
  vlParcela         Float    @default(0)
  vlQuitacao        Float    @default(0)
  vlReceber         Float    @default(0)
  tipoBem           String?
  needsReview       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientProfile ClientProfile? @relation(fields: [clientProfileId], references: [id])
  importBatch   ImportBatch?   @relation(fields: [importBatchId], references: [id])
  sales         Sale[]

  @@index([userId])
  @@index([clientProfileId])
  @@index([grupo, cota])
  @@map("quotas")
}

model ImportBatch {
  id                String    @id @default(cuid())
  userId            String
  importedForUserId String?
  sourceType        String    @default("PDF")
  filename          String
  status            String
  clientName        String?
  clientCpf         String?
  parsedAt          DateTime?
  createdAt         DateTime  @default(now())
  errorsJson        String?

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  importedForUser User?         @relation("ImportedForUser", fields: [importedForUserId], references: [id])
  quotas          Quota[]
  totals          ImportTotals?

  @@index([userId])
  @@index([importedForUserId])
  @@map("import_batches")
}

model ImportTotals {
  id              String      @id @default(cuid())
  importBatchId   String      @unique
  totalCotas      Int
  totalVlBem      Float
  totalVlParcela  Float
  totalVlQuitacao Float
  totalVlReceber  Float
  importBatch     ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
}

// ============================================
// SIMULAÇÕES (SANDBOX FINANCEIRO - ISOLADO)
// ============================================
// ⚠️ REGRA CRÍTICA: NUNCA FK para Quota, Sale, ClientProfile
// ⚠️ Este módulo é 100% isolado dos dados reais

model Simulation {
  id            String   @id @default(cuid())
  userId        String
  name          String   @default("Simulação Sem Nome")
  description   String?
  simulatorType String   @default("ACUMULO") // IMOVEIS | VEICULOS | FROTA | LANCE | ACUMULO | SORTEIO
  isFavorite    Boolean  @default(false)
  isTemplate    Boolean  @default(false)
  params        String // JSON SimulationParams
  isSimulation  Boolean  @default(true) // Flag de segurança
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ✅ PERMITIDO: FK apenas para User (autenticação)
  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs SimulationRun[]

  // ❌ PROIBIDO: NUNCA FK para Quota, Sale, ClientProfile, CommissionEntry, etc.

  @@index([userId])
  @@index([userId, isFavorite])
  @@index([userId, simulatorType])
  @@index([isSimulation])
  @@map("simulation_projects") // Renomeado para deixar explícito
}

model SimulationRun {
  id                       String   @id @default(cuid())
  simulationId             String
  name                     String?
  executedAt               DateTime @default(now())
  params                   String // JSON SimulationParams (snapshot do usado)
  quotaIds                 String // JSON string[] - APENAS IDs como string, NÃO FK
  patrimonioFinal          Float    @default(0)
  totalPagoParcelas        Float    @default(0)
  totalPagoBolso           Float    @default(0)
  totalRecebidoVendas      Float    @default(0)
  caixaFinalInvestido      Float    @default(0)
  custoPatrimonio          Float    @default(0)
  roi                      Float    @default(0)
  multiplicadorPatrimonial Float    @default(0)
  custoPorReal             Float    @default(0)
  numContemplacoes         Int      @default(0)
  numVendas                Int      @default(0)
  cotasAtivasFinal         Int      @default(0)
  comparacaoCdi            String? // JSON Comparacao
  comparacaoPoupanca       String? // JSON Comparacao
  resumoTexto              String?
  isSimulation             Boolean  @default(true) // Flag de segurança

  // ✅ PERMITIDO: FK apenas para Simulation (domínio próprio)
  simulation Simulation        @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  snapshots  MonthlySnapshot[]
  events     EventLog[]

  // ❌ PROIBIDO: NUNCA FK para Quota, Sale, ClientProfile, CommissionEntry, etc.

  @@index([simulationId])
  @@index([executedAt])
  @@index([isSimulation])
  @@map("simulation_runs")
}

model MonthlySnapshot {
  id                String   @id @default(cuid())
  simulationRunId   String
  mes               Int
  mesLabel          String
  parcelasPagas     Int      @default(0)
  valorParcelas     Float    @default(0)
  contemplacoes     Int      @default(0)
  vendas            Int      @default(0)
  valorVendas       Float    @default(0)
  caixa             Float    @default(0)
  caixaInvestido    Float    @default(0)
  patrimonio        Float    @default(0)
  creditoAtualizado Float    @default(0)
  totalPago         Float    @default(0)
  totalPagoBolso    Float    @default(0)
  cdiAcumulado      Float?
  poupancaAcumulado Float?
  createdAt         DateTime @default(now())

  // ✅ PERMITIDO: FK apenas para SimulationRun (domínio próprio)
  simulationRun SimulationRun @relation(fields: [simulationRunId], references: [id], onDelete: Cascade)

  // ❌ PROIBIDO: NUNCA FK para Quota, Sale, ClientProfile, CommissionEntry, etc.

  @@unique([simulationRunId, mes])
  @@index([simulationRunId])
  @@map("simulation_snapshots") // Renomeado para deixar explícito
}

model EventLog {
  id              String   @id @default(cuid())
  simulationRunId String
  tipo            String // PAGAMENTO | CONTEMPLACAO | VENDA | APLICACAO | REINVESTIMENTO
  mes             Int
  cotaId          String? // APENAS string (referência simulada), NÃO FK para Quota real
  cotaGrupo       String? // Referência por string (simulada)
  cotaNumero      String? // Referência por string (simulada)
  valor           Float    @default(0)
  descricao       String
  destino         String?
  metadata        String? // JSON
  isSimulation    Boolean  @default(true) // Flag de segurança
  createdAt       DateTime @default(now())

  // ✅ PERMITIDO: FK apenas para SimulationRun (domínio próprio)
  simulationRun SimulationRun @relation(fields: [simulationRunId], references: [id], onDelete: Cascade)

  // ❌ PROIBIDO: NUNCA FK para Quota, Sale, ClientProfile, CommissionEntry, etc.
  // ❌ cotaId é apenas string de referência simulada, NÃO FK para tabela real

  @@index([simulationRunId])
  @@index([simulationRunId, mes])
  @@index([simulationRunId, tipo])
  @@index([isSimulation])
  @@map("simulation_events") // Renomeado para deixar explícito
}

// ============================================
// VENDAS E COMISSÕES (DADOS REAIS - OPERAÇÃO)
// ============================================
// ⚠️ REGRA CRÍTICA: NUNCA FK para Simulation, SimulationRun, etc.
// ⚠️ Este módulo é 100% isolado das simulações

model Sale {
  id                String    @id @default(cuid())
  clientId          String
  sellerId          String
  partnerId         String?
  quotaId           String?
  productType       String
  creditAmount      Float
  installmentAmount Float
  term              Int
  status            String    @default("proposta")
  saleDate          DateTime?
  contemplationDate DateTime?
  commissionRate    Float?
  notes             String?
  metadata          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  client          User              @relation("ClientSales", fields: [clientId], references: [id])
  seller          User              @relation("SellerSales", fields: [sellerId], references: [id])
  partner         User?             @relation("PartnerSales", fields: [partnerId], references: [id])
  quota           Quota?            @relation(fields: [quotaId], references: [id])
  commissions     CommissionEntry[]
  payoutEntries   PayoutEntry[]
  SellerProfile   SellerProfile?    @relation(fields: [sellerProfileId], references: [id])
  sellerProfileId String?

  @@index([clientId])
  @@index([sellerId])
  @@index([partnerId])
  @@index([status])
  @@index([saleDate])
  @@map("sales")
}

model CommissionRule {
  id            String    @id @default(cuid())
  name          String
  description   String?
  levelId       String?
  productType   String?
  baseRate      Float     @default(0)
  splitRules    String
  overrideRules String?
  bonusRules    String?
  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  entries CommissionEntry[]

  @@index([isActive])
  @@index([validFrom, validUntil])
  @@map("commission_rules")
}

model CommissionEntry {
  id         String    @id @default(cuid())
  saleId     String
  userId     String
  ruleId     String?
  role       String
  baseAmount Float
  rate       Float
  amount     Float
  override   Float     @default(0)
  bonus      Float     @default(0)
  total      Float
  status     String    @default("pending")
  paidAt     DateTime?
  payoutId   String?
  notes      String?
  metadata   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sale   Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id])
  rule   CommissionRule? @relation(fields: [ruleId], references: [id])
  payout Payout?         @relation(fields: [payoutId], references: [id])

  @@index([saleId])
  @@index([userId])
  @@index([status])
  @@index([payoutId])
  @@map("commission_entries")
}

model Payout {
  id               String    @id @default(cuid())
  userId           String
  period           String
  totalAmount      Float
  status           String    @default("pending")
  paidAt           DateTime?
  paymentMethod    String?
  paymentReference String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user          User              @relation("UserPayouts", fields: [userId], references: [id])
  entries       CommissionEntry[]
  payoutEntries PayoutEntry[]

  @@index([userId])
  @@index([period])
  @@index([status])
  @@map("payouts")
}

model PayoutEntry {
  id        String   @id @default(cuid())
  payoutId  String
  saleId    String
  amount    Float
  createdAt DateTime @default(now())

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  sale   Sale   @relation(fields: [saleId], references: [id])

  @@index([payoutId])
  @@index([saleId])
  @@map("payout_entries")
}

// ============================================
// ÍNDICES E MARKET DATA
// ============================================

model IndexSeries {
  id        String   @id @default(cuid())
  tipo      String
  data      DateTime
  valor     Float
  fonte     String   @default("manual")
  periodo   String   @default("monthly")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tipo, data, periodo])
  @@index([tipo, data])
  @@map("index_series")
}

// ============================================
// RELATÓRIOS
// ============================================

model Report {
  id              String   @id @default(cuid())
  userId          String
  simulationRunId String?
  type            String
  format          String   @default("pdf")
  arquivoUrl      String?
  params          String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([simulationRunId])
  @@map("reports")
}

// ============================================
// AUDITORIA E LOGS
// ============================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  changes    String?
  ipAddress  String?
  userAgent  String?
  metadata   String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
